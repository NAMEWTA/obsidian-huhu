+            "{}: {} (effect: {})",
+            value["error"]["code"].as_str().unwrap_or("EFFECT_UNKNOWN"),
+            value["error"]["message"]
+                .as_str()
+                .unwrap_or("Control failed"),
+            value["effect"].as_str().unwrap_or("unknown")
+        );
+    }
+}
