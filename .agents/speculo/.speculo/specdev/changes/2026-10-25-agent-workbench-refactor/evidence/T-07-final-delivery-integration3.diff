+		const stdout = [], stderr = [];
+		let outBytes = 0, errBytes = 0;
+		/** @type {Error | undefined} */
+		let failure;
+		/** @type {ReturnType<typeof setTimeout> | undefined} */
+		let escalation;
+		/** @param {Error} error */
+		const stop = (error) => {
+			if (failure) return;
