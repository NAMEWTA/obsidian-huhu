@@ -0,0 +1,56 @@
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { expect, it, vi } from 'vitest';
+import { TestProviders } from '../../../ui/react/test-providers';
+import { t } from '../../../shared/i18n';
+import type { BrowserFile, PendingHumanRequest } from '../api';
+import { PendingRequestCard } from './PendingRequestCard';
+import { workspaceFixture } from './testing/workspace';
+
+it('waits for the human epoch and rejects a file picker result after the request revision changes', async () => {
+	const f = workspaceFixture(),
+		lease = await f.api.takeover({ spaceId: 'space', viewerId: 'viewer', windowId: 'window' });
+	const scope = { spaceId: 'space', pageId: 'page', viewerId: 'viewer', leaseId: lease.leaseId, epoch: lease.epoch };
+	const request: PendingHumanRequest = {
+		id: 'request',
+		spaceId: 'space',
+		pageId: 'page',
+		runtimeId: 'runtime',
+		documentId: 'document',
+		epoch: lease.epoch - 1,
+		revision: 1,
+		kind: 'file-chooser',
+		message: '<script>untrusted</script>',
+		expiresAt: Date.now() + 60_000,
+		status: 'pending',
+	};
+	f.set({ ...f.api.getState(), requests: [request] });
+	const report = vi.fn();
+	const content = (value: PendingHumanRequest) => (
+		<TestProviders>
+			<PendingRequestCard api={f.api} request={value} authority={() => scope} report={report} />
+		</TestProviders>
+	);
+	const view = render(content(request));
+	expect((screen.getByRole('button', { name: t('browser.v2.chooseFiles') }) as HTMLButtonElement).disabled).toBe(
+		true,
+	);
+	expect(document.querySelector('script')).toBeNull();
+	const fresh = { ...request, epoch: lease.epoch, revision: 2 };
+	f.set({ ...f.api.getState(), requests: [fresh] });
+	view.rerender(content(fresh));
+	let finish!: (file: BrowserFile | undefined) => void;
+	vi.mocked(f.api.chooseUpload).mockImplementation(
+		() =>
+			new Promise<BrowserFile | undefined>((resolve) => {
+				finish = resolve;
+			}),
+	);
+	fireEvent.click(screen.getByRole('button', { name: t('browser.v2.chooseFiles') }));
+	f.set({ ...f.api.getState(), requests: [{ ...fresh, revision: 3 }] });
+	await act(async () => finish(undefined));
+	await waitFor(() =>
+		expect(report).toHaveBeenCalledWith(expect.objectContaining({ message: 'browser_stale_request' })),
+	);
+	expect(f.api.pageAction).not.toHaveBeenCalled();
+	expect(f.api.chooseUpload).toHaveBeenCalledWith('space', 'human');
+});
diff --git a/src/modules/browser/ui/PendingRequestCard.tsx b/src/modules/browser/ui/PendingRequestCard.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..17941a88d2a721b292a7bdcb4983491d2bd98ad6
--- /dev/null
+++ b/src/modules/browser/ui/PendingRequestCard.tsx
@@ -0,0 +1,123 @@
+import { useState } from 'react';
+import type { BrowserWorkspace, HumanPageRequest, PendingHumanRequest } from '../api';
+import { Button } from '../../../ui/components/button';
+import { Input } from '../../../ui/components/input';
+import { useT } from '../../../ui/react/hooks';
+import { captureHumanPage, sameHumanPage } from './human-authority';
+
+export function PendingRequestCard({
+	api,
+	request,
+	authority,
+	report,
+}: {
+	api: BrowserWorkspace;
+	request: PendingHumanRequest;
+	authority: () => HumanPageRequest | undefined;
+	report: (reason: unknown) => void;
+}) {
+	const t = useT();
+	const [reply, setReply] = useState('');
+	const [pending, setPending] = useState(false);
+	const scope = authority();
+	const canAnswer =
+		request.status === 'pending' &&
+		request.kind !== 'permission' &&
+		request.kind !== 'http-auth' &&
+		!!scope &&
+		scope.epoch === request.epoch &&
+		scope.spaceId === request.spaceId &&
+		scope.pageId === request.pageId;
+	const answer = async (accept: boolean) => {
+		const captured = authority();
+		const page = captured && captureHumanPage(api, captured);
+		if (!canAnswer || !captured || !page || captured.epoch !== request.epoch) return;
+		setPending(true);
+		try {
+			const file =
+				request.kind === 'file-chooser' && accept
+					? await api.chooseUpload(captured.spaceId, 'human')
+					: undefined;
+			const latest = api.getState().requests.find((item) => item.id === request.id);
+			if (
+				!sameHumanPage(api, captured, authority(), page) ||
+				latest?.revision !== request.revision ||
+				latest.epoch !== captured.epoch ||
+				latest.status !== 'pending'
+			)
+				throw new Error('browser_stale_request');
+			await api.pageAction({
+				...captured,
+				command:
+					request.kind === 'dialog'
+						? {
+								kind: 'dialog',
+								requestId: request.id,
+								revision: request.revision,
+								accept,
+								...(accept && reply ? { text: reply } : {}),
+							}
+						: {
+								kind: 'chooser',
+								requestId: request.id,
+								revision: request.revision,
+								fileIds: file ? [file.id] : [],
+							},
+			});
+		} catch (reason) {
+			report(reason);
+		} finally {
+			setPending(false);
+		}
+	};
+	return (
+		<section
+			className="space-y-2 border-b border-border bg-muted/30 p-3 text-sm"
+			aria-label={t(request.kind === 'dialog' ? 'browser.v2.dialogTitle' : 'browser.v2.chooserTitle')}
+		>
+			<p className="break-words font-medium">
+				{t(
+					request.kind === 'http-auth'
+						? 'browser.v2.authDenied'
+						: request.kind === 'permission'
+							? 'browser.v2.permissionDenied'
+							: request.kind === 'dialog'
+								? 'browser.v2.dialogTitle'
+								: 'browser.v2.chooserTitle',
+				)}
+			</p>
+			{request.message && (
+				<p className="max-h-28 overflow-auto whitespace-pre-wrap break-words">{request.message}</p>
+			)}
+			{request.status !== 'pending' ? (
+				<p>{t('browser.v2.requestDenied')}</p>
+			) : request.kind === 'dialog' || request.kind === 'file-chooser' ? (
+				<>
+					{!canAnswer && <p className="text-muted-foreground">{t('browser.v2.requestWaiting')}</p>}
+					{request.kind === 'dialog' && (
+						<Input
+							aria-label={t('browser.v2.dialogReply')}
+							value={reply}
+							maxLength={4096}
+							disabled={!canAnswer || pending}
+							onChange={(event) => setReply(event.target.value)}
+						/>
+					)}
+					<div className="flex flex-wrap gap-2">
+						<Button size="sm" disabled={!canAnswer || pending} onClick={() => void answer(true)}>
+							{t(request.kind === 'dialog' ? 'browser.v2.accept' : 'browser.v2.chooseFiles')}
+						</Button>
+						<Button
+							size="sm"
+							variant="outline"
+							disabled={!canAnswer || pending}
+							onClick={() => void answer(false)}
+						>
+							{t('browser.v2.dismiss')}
+						</Button>
+					</div>
+				</>
+			) : null}
+		</section>
+	);
+}
diff --git a/src/modules/browser/ui/SendMaterialButton.tsx b/src/modules/browser/ui/SendMaterialButton.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c63a17026c6ea5ec75f970b34e94ec77fcfd3736
--- /dev/null
+++ b/src/modules/browser/ui/SendMaterialButton.tsx
@@ -0,0 +1,128 @@
+import { useEffect, useRef, useState } from 'react';
+import { Send } from 'lucide-react';
+import type { BrowserWorkspace, HumanPageRequest } from '../api';
+import { Button } from '../../../ui/components/button';
+import {
+	Dialog,
+	DialogContent,
+	DialogHeader,
+	DialogTitle,
+	DialogDescription,
+	DialogFooter,
+} from '../../../ui/components/dialog';
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '../../../ui/components/select';
+import { useT } from '../../../ui/react/hooks';
+import { captureHumanPage, sameHumanPage } from './human-authority';
+
+export function SendMaterialButton({
+	api,
+	authority,
+	disabled,
+	report,
+}: {
+	api: BrowserWorkspace;
+	authority: () => HumanPageRequest | undefined;
+	disabled: boolean;
+	report: (reason: unknown) => void;
+}) {
+	const t = useT();
+	const [open, setOpen] = useState(false);
+	const [pending, setPending] = useState(false);
+	const [targets, setTargets] = useState<Array<{ id: string; label: string }>>([]);
+	const [target, setTarget] = useState('');
+	const [sent, setSent] = useState(false);
+	const generation = useRef(0),
+		mounted = useRef(false);
+	useEffect(() => {
+		mounted.current = true;
+		generation.current++;
+		return () => {
+			mounted.current = false;
+		};
+	}, [authority]);
+	const choose = async () => {
+		const current = generation.current;
+		setPending(true);
+		setSent(false);
+		try {
+			const items = await api.listMaterialTargets();
+			if (!mounted.current || current !== generation.current) return;
+			setTargets(items);
+			setTarget('');
+			setOpen(true);
+		} catch (reason) {
+			if (mounted.current && current === generation.current) report(reason);
+		} finally {
+			if (mounted.current && current === generation.current) setPending(false);
+		}
+	};
+	const send = async () => {
+		const scope = authority(),
+			page = scope && captureHumanPage(api, scope),
+			current = generation.current;
+		if (!scope || !page || !target) return;
+		setPending(true);
+		try {
+			if (!sameHumanPage(api, scope, authority(), page)) throw new Error('control_revoked');
+			await api.sendMaterial({ ...scope, targetId: target });
+			if (mounted.current && current === generation.current) {
+				setOpen(false);
+				setSent(true);
+			}
+		} catch (reason) {
+			if (mounted.current && current === generation.current) report(reason);
+		} finally {
+			if (mounted.current && current === generation.current) setPending(false);
+		}
+	};
+	return (
+		<>
+			<Button size="sm" variant="outline" disabled={disabled || pending} onClick={() => void choose()}>
+				<Send />
+				{t('browser.v2.sendMaterial')}
+			</Button>
+			{sent && (
+				<span role="status" className="text-xs text-muted-foreground">
+					{t('browser.v2.materialSent')}
+				</span>
+			)}
+			<Dialog
+				open={open}
+				onOpenChange={(value) => {
+					if (!pending) setOpen(value);
+				}}
+			>
+				<DialogContent>
+					<DialogHeader>
+						<DialogTitle>{t('browser.v2.materialTarget')}</DialogTitle>
+						<DialogDescription>{t('browser.v2.materialHelp')}</DialogDescription>
+					</DialogHeader>
+					{targets.length ? (
+						<Select value={target} onValueChange={setTarget}>
+							<SelectTrigger aria-label={t('browser.v2.materialTarget')}>
+								<SelectValue placeholder={t('browser.v2.materialTarget')} />
+							</SelectTrigger>
+							<SelectContent>
+								{targets.map((item) => (
+									<SelectItem key={item.id} value={item.id}>
+										{item.label}
+									</SelectItem>
+								))}
+							</SelectContent>
+						</Select>
+					) : (
+						<p>{t('browser.v2.materialEmpty')}</p>
+					)}
+					<DialogFooter>
+						<Button variant="outline" disabled={pending} onClick={() => setOpen(false)}>
+							{t('browser.v2.cancel')}
+						</Button>
+						<Button disabled={pending || disabled || !target} onClick={() => void send()}>
+							{t('browser.v2.sendMaterial')}
+						</Button>
+					</DialogFooter>
+				</DialogContent>
+			</Dialog>
+		</>
+	);
+}
diff --git a/src/modules/browser/ui/SpaceViewer.dom.test.tsx b/src/modules/browser/ui/SpaceViewer.dom.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b88660e24525b53ddd918ae5af87d631fc6eb993
--- /dev/null
+++ b/src/modules/browser/ui/SpaceViewer.dom.test.tsx
@@ -0,0 +1,244 @@
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+import { TestProviders } from '../../../ui/react/test-providers';
+import { HuhuProviders } from '../../../ui/react/providers';
+import { t } from '../../../shared/i18n';
+import { SpaceViewer } from './SpaceViewer';
+import { workspaceFixture } from './testing/workspace';
+
+const draw = vi.fn(),
+	clear = vi.fn();
+beforeEach(() => {
+	class Image {
+		naturalWidth = 1280;
+		naturalHeight = 800;
+		onload: (() => void) | null = null;
+		onerror: (() => void) | null = null;
+		set src(value: string) {
+			if (value) queueMicrotask(() => this.onload?.());
+		}
+	}
+	vi.stubGlobal('Image', Image);
+	vi.spyOn(URL, 'createObjectURL').mockReturnValue('blob:viewer-test');
+	vi.spyOn(URL, 'revokeObjectURL').mockImplementation(() => {});
+	vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockReturnValue({
+		drawImage: draw,
+		clearRect: clear,
+	} as unknown as CanvasRenderingContext2D);
+	vi.spyOn(HTMLCanvasElement.prototype, 'getBoundingClientRect').mockReturnValue({
+		left: 0,
+		top: 0,
+		width: 800,
+		height: 500,
+		right: 800,
+		bottom: 500,
+		x: 0,
+		y: 0,
+		toJSON: () => ({}),
+	});
+});
+afterEach(() => {
+	vi.restoreAllMocks();
+	vi.unstubAllGlobals();
+	draw.mockClear();
+	clear.mockClear();
+});
+
+async function human(f: ReturnType<typeof workspaceFixture>) {
+	fireEvent.click(screen.getByRole('button', { name: t('browser.v2.takeover') }));
+	await waitFor(() => expect(f.api.takeover).toHaveBeenCalledOnce());
+	await waitFor(() => expect(screen.getByLabelText(t('browser.v2.textInput'))).toBeTruthy());
+	const frame = f.frame();
+	act(() => f.emit(frame));
+	await waitFor(() => expect(f.ack).toHaveBeenCalledWith(frame.frameId));
+	return frame;
+}
+
+it('opens as an observer, retains the stream during takeover, rejects stale frames and releases only its viewer on close', async () => {
+	const f = workspaceFixture();
+	const view = render(
+		<TestProviders>
+			<SpaceViewer api={f.api} spaceId="space" pageId="page" />
+		</TestProviders>,
+	);
+	const canvas = screen.getByLabelText(t('browser.v2.canvas'));
