@@ -0,0 +1,556 @@
+import { build } from 'esbuild';
+import { spawn } from 'node:child_process';
+import { createServer } from 'node:http';
+import { randomBytes, randomUUID, createHash } from 'node:crypto';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+import { setTimeout as delay } from 'node:timers/promises';
+import assert from 'node:assert/strict';
+
+const [helperArg, chromeArg, evidenceArg] = process.argv.slice(2);
+if (!helperArg || !chromeArg || !evidenceArg)
+	throw Error('Usage: node scripts/verify-browser-runtime-native.mjs <helper> <full-chrome> <new-evidence-dir>');
+const helper = path.resolve(helperArg),
+	chrome = path.resolve(chromeArg),
+	evidence = path.resolve(evidenceArg);
+await fs.mkdir(evidence, { mode: 0o700 });
+const compiled = path.join(evidence, 'driver.cjs');
+await build({
+	entryPoints: ['src/modules/browser/platform/desktop/runtime/driver.ts'],
+	bundle: true,
+	platform: 'node',
+	format: 'cjs',
+	target: 'node22',
+	outfile: compiled,
+	logLevel: 'warning',
+});
+const { BrowserDriver } = createRequire(import.meta.url)(compiled);
+const helperLocal = path.join(evidence, 'huhu-browser-runtime');
+await fs.copyFile(helper, helperLocal);
+await fs.chmod(helperLocal, 0o755);
+if (process.getuid?.() === 0) {
+	await fs.chown(evidence, 65534, 65534);
+	await fs.chmod(evidence, 0o700);
+	process.setgid(65534);
+	process.setuid(65534);
+}
+const checks = [];
+const runtimes = [];
+const events = [];
+const check = (name, data = {}) => {
+	checks.push({ name, ...data });
+	console.log('PASS ' + name);
+};
+async function until(predicate, timeout = 12000) {
+	const start = Date.now();
+	while (Date.now() - start < timeout) {
+		const result = await predicate();
+		if (result) return result;
+		await delay(25);
+	}
+	throw Error('Timed out waiting for expected browser event');
+}
+const server = createServer((req, res) => {
+	if (req.url === '/auth') {
+		res.writeHead(401, { 'WWW-Authenticate': 'Basic realm="HUHU isolated fixture"', 'Content-Type': 'text/html' });
+		res.end('<title>Authentication denied</title>Denied');
+		return;
+	}
+	if (req.url === '/download') {
+		res.writeHead(200, {
+			'Content-Disposition': 'attachment; filename="fixture.txt"',
+			'Content-Type': 'text/plain',
+		});
+		res.end('Authorized browser fixture');
+		return;
+	}
+	if (req.url === '/frame') {
+		res.setHeader('Content-Type', 'text/html');
+		res.end(
+			'<button aria-label="Frame counter" onclick="this.textContent=\'Frame clicked\'">Frame counter</button>',
+		);
+		return;
+	}
+	res.setHeader('Content-Type', 'text/html');
+	res.end(
+		`<!doctype html><meta charset="UTF-8"><title>Owned browser fixture</title><style>body{font:20px sans-serif;margin:24px}button,input,select{font:20px sans-serif;margin:5px;padding:8px}iframe{width:500px;height:90px}</style><script>window.__events=[];for(const type of ["mousedown","mouseup","click"])document.addEventListener(type,e=>window.__events.push({type,x:e.clientX,y:e.clientY,target:e.target.getAttribute("aria-label")}),true)</script><h1>HUHU isolated fixture</h1><input aria-label="Fixture input"><select aria-label="Fixture select"><option value="a">Alpha</option><option value="b">Beta</option></select><button aria-label="Counter" onclick="this.dataset.count=String(+(this.dataset.count||0)+1);this.textContent='Count '+this.dataset.count">Counter</button><button aria-label="Prompt" onclick="document.querySelector('output').textContent='Prompt:'+prompt('Fixture prompt')">Prompt</button><button aria-label="Select heading" onclick="const r=document.createRange();r.selectNodeContents(document.querySelector('h1'));getSelection().removeAllRanges();getSelection().addRange(r)">Select heading</button><button aria-label="Choose file" onclick="document.querySelector('#file').click()">Choose file</button><input id="file" type="file" hidden><a href="/download">Download fixture</a><output></output><iframe src="http://localhost:${server.address().port}/frame"></iframe>`,
+	);
+});
+await new Promise((resolve) => server.listen(0, '0.0.0.0', resolve));
+const origin = `http://127.0.0.1:${server.address().port}`;
+async function start(name) {
+	const directory = path.join(evidence, name);
+	await fs.mkdir(directory, { mode: 0o700 });
+	const profile = path.join(directory, 'profile'),
+		downloadPath = path.join(directory, 'downloads');
+	await fs.mkdir(profile, { mode: 0o700 });
+	await fs.mkdir(downloadPath, { mode: 0o700 });
+	const runtimeId = randomUUID(),
+		spaceId = randomUUID(),
+		key = randomBytes(32).toString('hex'),
+		token = randomBytes(32).toString('hex');
+	const provisioning = {
+		runtimeId,
+		spaceId,
+		epoch: 0,
+		leaseId: randomUUID(),
+		controllerId: 'provisioning',
+		mode: 'workspace',
+		expiresAt: Number.MAX_SAFE_INTEGER,
+	};
+	const child = spawn(helperLocal, [], { stdio: ['pipe', 'pipe', 'pipe'] });
+	let remaining = Buffer.alloc(0),
+		next = 0;
+	const pending = new Map();
+	let closed = false;
+	child.stderr.resume();
+	child.on('error', (error) => {
+		for (const item of pending.values()) item.reject(error);
+		pending.clear();
+	});
+	child.on('close', () => {
+		closed = true;
+		for (const item of pending.values()) item.reject(Error('Native helper closed'));
+		pending.clear();
+	});
+	child.stdout.on('data', (bytes) => {
+		remaining = Buffer.concat([remaining, bytes]);
+		while (remaining.length >= 4) {
+			const length = remaining.readUInt32BE(0);
+			if (remaining.length < length + 4) break;
+			const message = JSON.parse(remaining.subarray(4, length + 4));
+			remaining = remaining.subarray(length + 4);
+			const item = pending.get(message.id);
+			if (item) {
+				pending.delete(message.id);
+				clearTimeout(item.timer);
+				message.error ? item.reject(Error(message.error)) : item.resolve(message.result);
+			} else if (message.type === 'fatal') events.push({ kind: 'native-fault', runtimeId, code: message.code });
+		}
+	});
+	const call = (message, timeout = 10000) =>
+		new Promise((resolve, reject) => {
+			const id = ++next,
+				timer = setTimeout(() => {
+					pending.delete(id);
+					reject(Error('Native control timeout'));
+				}, timeout);
