diff --git a/src/modules/browser/ui/workbench-page.tsx b/src/modules/browser/ui/workbench-page.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..95ce3138d6095668c0cffefd2364c1afc865440a
--- /dev/null
