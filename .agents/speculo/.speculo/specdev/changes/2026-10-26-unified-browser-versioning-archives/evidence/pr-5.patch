@@ -0,0 +1,22 @@
+# Browser 原生 helper
+
+完整的设计、数据边界、支持平台与安装说明见 [浏览器运行时](../../docs/browser-runtime.md)。维护说明以该文档为准。
+
+从仓库根目录构建与验证：
+
+```sh
+pnpm exec tsc -p tsconfig.browser-worker.json
+node scripts/build-browser-runtime.mjs
+cargo test --locked --manifest-path native/browser-runtime/Cargo.toml
+cargo build --release --locked --manifest-path native/browser-runtime/Cargo.toml
+node scripts/install-browser-runtime.mjs \\
+  native/browser-runtime/target/release/huhu-browser-runtime \\
+  /absolute/new-runtime-bundle \\
+  /absolute/download-cache
+node scripts/verify-browser-runtime-native.mjs \\
+  /absolute/huhu-browser-runtime \\
+  /absolute/chrome-linux64/chrome \\
+  /absolute/new-native-evidence-directory
+```
+
+生产仅启用 Linux x64，Chrome sandbox 始终开启；其他平台必须通过自己的原生进程隔离和真实宿主门禁之后才能启用。
diff --git a/native/browser-runtime/src/cookies.rs b/native/browser-runtime/src/cookies.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9825a10f1328405b374db16ffe3963a0038172f4
--- /dev/null
+++ b/native/browser-runtime/src/cookies.rs
@@ -0,0 +1,92 @@
+//! Independent read-only reader for a caller-owned source snapshot. No Agent/PTY runtime is involved.
+use rusqlite::{types::ValueRef, Connection, OpenFlags};
+use serde_json::{json, Map, Value};
+use std::{collections::HashSet, path::Path, time::Duration};
+
+pub fn read_request(input: &str) -> Result<Value, String> {
+    if input.len() > 32 * 1024 { return Err("source_request_invalid".into()); }
+    let request: Value = serde_json::from_str(input).map_err(|_| "source_request_invalid")?;
+    read(&request).map_err(|_| "source_unavailable".to_string())
+}
+fn read(request: &Value) -> Result<Value, Box<dyn std::error::Error>> {
+    let file = request["path"].as_str().ok_or("missing path")?;
+    let kind = request["kind"].as_str().ok_or("missing kind")?;
+    if !Path::new(file).is_absolute() || !["chromium", "firefox"].contains(&kind) { return Err("invalid request".into()); }
+    let metadata = std::fs::symlink_metadata(file)?;
+    if !metadata.is_file() || metadata.file_type().is_symlink() || metadata.len() > 256 * 1024 * 1024 { return Err("invalid snapshot".into()); }
+    let db = Connection::open_with_flags(file, OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX)?;
+    db.busy_timeout(Duration::from_secs(3))?;
+    db.execute_batch("PRAGMA query_only=ON; PRAGMA trusted_schema=OFF;")?;
+    let table = if kind == "chromium" { "cookies" } else { "moz_cookies" };
+    let mut columns_stmt = db.prepare(&format!("PRAGMA table_info({table})"))?;
+    let columns = columns_stmt.query_map([], |row| row.get::<_, String>(1))?.collect::<Result<Vec<_>, _>>()?;
+    let known: HashSet<&str> = columns.iter().map(String::as_str).collect();
+    let mapping: &[(&str, &str)] = if kind == "chromium" {
+        &[("host_key","host_key"),("name","name"),("value","value"),("encrypted_value","encrypted_value_hex"),("path","path"),
+          ("expires_utc","expires_utc"),("is_secure","is_secure"),("is_httponly","is_httponly"),("samesite","samesite"),
+          ("has_expires","has_expires"),("top_frame_site_key","top_frame_site_key"),("has_cross_site_ancestor","has_cross_site_ancestor"),
+          ("is_same_party","is_same_party"),("priority","priority"),("source_scheme","source_scheme"),("source_port","source_port")]
+    } else {
+        &[("host","host_key"),("name","name"),("value","value"),("path","path"),("expiry","expiry"),("isSecure","is_secure"),
+          ("isHttpOnly","is_httponly"),("sameSite","samesite"),("originAttributes","origin_attributes")]
+    };
+    for required in [if kind == "chromium" { "host_key" } else { "host" }, "name", "value", "path"] {
+        if !known.contains(required) { return Err("unsupported schema".into()); }
+    }
+    let fields: Vec<String> = mapping.iter().map(|(column, _)| if known.contains(column) { format!("\"{column}\"") } else { "NULL".into() }).collect();
+    let mut statement = db.prepare(&format!("SELECT {} FROM {table} LIMIT 50001", fields.join(",")))?;
+    let mut cursor = statement.query([])?;
+    let mut rows = Vec::new(); let mut bytes = 0usize;
+    while let Some(row) = cursor.next()? {
+        if rows.len() >= 50000 { return Err("too many rows".into()); }
+        let mut result = Map::new();
+        for (index, (_, name)) in mapping.iter().enumerate() {
+            let value = match row.get_ref(index)? {
+                ValueRef::Null => Value::Null,
+                ValueRef::Integer(value) => if ["expires_utc", "expiry"].contains(name) { Value::String(value.to_string()) } else { json!(value) },
+                ValueRef::Text(value) => Value::String(std::str::from_utf8(value)?.to_owned()),
+                ValueRef::Blob(value) if *name == "encrypted_value_hex" => Value::String(value.iter().map(|byte| format!("{byte:02x}")).collect()),
+                _ => return Err("unsupported value".into()),
+            };
+            result.insert((*name).into(), value);
+        }
+        bytes += serde_json::to_vec(&result)?.len();
+        if bytes > 64 * 1024 * 1024 { return Err("snapshot too large".into()); }
+        rows.push(Value::Object(result));
+    }
+    let version: Option<String> = if kind == "chromium" {
+        db.query_row("SELECT value FROM meta WHERE key='version'", [], |row| {
+            Ok(match row.get_ref(0)? { ValueRef::Integer(value) => Some(value.to_string()), ValueRef::Text(value) => std::str::from_utf8(value).ok().map(str::to_owned), _ => None })
+        }).ok().flatten()
+    } else { None };
+    Ok(json!({"schemaVersion":2,"kind":kind,"databaseVersion":version,"columns":columns,"rows":rows}))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn preserves_partition_container_and_large_integer_semantics() {
+        let file = std::env::temp_dir().join(format!("huhu-native-cookie-reader-{}.sqlite", std::process::id()));
+        let _ = std::fs::remove_file(&file);
+        let db = Connection::open(&file).unwrap();
+        db.execute_batch("CREATE TABLE meta(key TEXT,value TEXT);INSERT INTO meta VALUES('version','24');CREATE TABLE cookies(host_key TEXT,name TEXT,value TEXT,encrypted_value BLOB,path TEXT,expires_utc INTEGER,is_secure INTEGER,is_httponly INTEGER,samesite INTEGER,top_frame_site_key TEXT,has_cross_site_ancestor INTEGER);INSERT INTO cookies VALUES('.example.test','sid','',X'763130ff','/',13390000000000001,1,1,1,'https://top.test',1);CREATE TABLE moz_cookies(host TEXT,name TEXT,value TEXT,path TEXT,expiry INTEGER,isSecure INTEGER,isHttpOnly INTEGER,sameSite INTEGER,originAttributes TEXT);INSERT INTO moz_cookies VALUES('example.test','sid','value','/',1800000000,1,1,2,'^userContextId=2');").unwrap();
+        drop(db);
+        let chromium = read_request(&json!({"path":file,"kind":"chromium"}).to_string()).unwrap();
+        assert_eq!(chromium["rows"][0]["expires_utc"], "13390000000000001");
+        assert_eq!(chromium["rows"][0]["top_frame_site_key"], "https://top.test");
+        assert_eq!(chromium["rows"][0]["has_cross_site_ancestor"], 1);
+        assert_eq!(chromium["rows"][0]["encrypted_value_hex"], "763130ff");
+        assert_eq!(chromium["databaseVersion"], "24");
+        let firefox = read_request(&json!({"path":file,"kind":"firefox"}).to_string()).unwrap();
+        assert_eq!(firefox["rows"][0]["origin_attributes"], "^userContextId=2");
+        std::fs::remove_file(file).unwrap();
+    }
+    #[test]
+    fn missing_source_never_creates_a_database() {
+        let file = std::env::temp_dir().join(format!("huhu-native-cookie-missing-{}.sqlite", std::process::id()));
+        let _ = std::fs::remove_file(&file);
+        assert!(read_request(&json!({"path":file,"kind":"chromium"}).to_string()).is_err());
+        assert!(!file.exists());
+    }
+}
diff --git a/native/browser-runtime/src/framing.rs b/native/browser-runtime/src/framing.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6e2578f2bcf38216fb164da8f7b7b43f5902055c
--- /dev/null
+++ b/native/browser-runtime/src/framing.rs
@@ -0,0 +1,45 @@
+use serde_json::Value;
+use std::io::{self, Read, Write};
+pub const MAX: usize = 16 * 1024 * 1024;
+pub fn read(reader: &mut impl Read) -> io::Result<Option<Value>> {
+    let mut header = [0u8; 4];
+    match reader.read_exact(&mut header) {
+        Ok(()) => (),
+        Err(e) if e.kind() == io::ErrorKind::UnexpectedEof => return Ok(None),
+        Err(e) => return Err(e),
+    }
+    let size = u32::from_be_bytes(header) as usize;
+    if size == 0 || size > MAX {
+        return Err(io::Error::other("frame_limit"));
+    }
+    let mut body = vec![0; size];
+    reader.read_exact(&mut body)?;
+    serde_json::from_slice(&body)
+        .map(Some)
+        .map_err(io::Error::other)
+}
+pub fn write(writer: &mut impl Write, value: &Value) -> io::Result<()> {
+    let data = serde_json::to_vec(value)?;
+    if data.is_empty() || data.len() > MAX {
+        return Err(io::Error::other("frame_limit"));
+    }
+    writer.write_all(&(data.len() as u32).to_be_bytes())?;
+    writer.write_all(&data)?;
+    writer.flush()
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bounded_round_trip() {
+        let mut b = Vec::new();
+        let v = serde_json::json!({"a":"中文"});
+        write(&mut b, &v).unwrap();
+        assert_eq!(read(&mut b.as_slice()).unwrap(), Some(v));
+    }
+    #[test]
+    fn oversized_rejected() {
+        let b = ((MAX + 1) as u32).to_be_bytes();
+        assert!(read(&mut b.as_slice()).is_err());
+    }
+}
diff --git a/native/browser-runtime/src/gate.rs b/native/browser-runtime/src/gate.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c3320881a69e5c9da9643b5067892b6e1cd15212
--- /dev/null
+++ b/native/browser-runtime/src/gate.rs
@@ -0,0 +1,269 @@
+use serde_json::Value;
+use std::time::{SystemTime, UNIX_EPOCH};
+pub struct Gate {
+    pub epoch: u64,
+    pub sequence: u64,
+    lease: String,
+    controller: String,
+    mode: String,
+    expires: u64,
+    pub closed: bool,
+}
+impl Gate {
+    pub fn new(provisioning: &str) -> Self {
+        Self {
+            epoch: 0,
+            sequence: 0,
+            lease: provisioning.into(),
+            controller: "provisioning".into(),
+            mode: "workspace".into(),
+            expires: u64::MAX,
+            closed: false,
+        }
+    }
+    pub fn control(&mut self, epoch: u64, lease: Option<&Value>) -> Result<(), &'static str> {
+        if self.closed || epoch < self.epoch {
+            return Err("browser_stale_control");
+        }
+        if let Some(v) = lease {
+            if v["epoch"].as_u64() != Some(epoch)
+                || !matches!(v["mode"].as_str(), Some("agent" | "human" | "workspace"))
+                || v["leaseId"].as_str().unwrap_or("").is_empty()
+                || v["controllerId"].as_str().unwrap_or("").is_empty()
+            {
+                return Err("browser_invalid_control");
+            }
+        }
+        if epoch == self.epoch {
+            let Some(v) = lease else {
+                return Err("browser_stale_control");
+            };
+            if v["leaseId"].as_str() != Some(&self.lease)
+                || v["controllerId"].as_str() != Some(&self.controller)
+                || v["mode"].as_str() != Some(&self.mode)
+                || v["expiresAt"].as_u64().unwrap_or(0) <= self.expires
+            {
+                return Err("browser_stale_control");
+            }
+            self.expires = v["expiresAt"].as_u64().unwrap();
+            return Ok(());
+        }
+        self.epoch = epoch;
+        self.lease = lease
+            .and_then(|v| v["leaseId"].as_str())
+            .unwrap_or("")
+            .into();
+        self.controller = lease
+            .and_then(|v| v["controllerId"].as_str())
+            .unwrap_or("")
+            .into();
+        self.mode = lease.and_then(|v| v["mode"].as_str()).unwrap_or("").into();
+        self.expires = lease.and_then(|v| v["expiresAt"].as_u64()).unwrap_or(0);
+        Ok(())
+    }
+    pub fn admit(&self, request: &Value) -> Result<Vec<u8>, &'static str> {
+        if self.closed {
+            return Err("browser_transport_closed");
+        }
+        let frames = request["frames"]
+            .as_array()
+            .ok_or("browser_invalid_dispatch")?;
+        if frames.is_empty() || frames.len() > 4 {
+            return Err("browser_gesture_limit");
+        }
+        let maintenance = request["lane"] == "maintenance";
+        if !maintenance {
+            let now = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_millis() as u64;
+            if self.lease.is_empty()
+                || request["epoch"].as_u64() != Some(self.epoch)
+                || request["leaseId"].as_str() != Some(&self.lease)
+                || request["controllerId"].as_str() != Some(&self.controller)
+                || now >= self.expires
+            {
+                return Err("browser_stale_control");
+            }
+        }
+        let mut mouse: Option<(Value, Value, Value)> = None;
+        let mut key: Option<(Value, Value, Value)> = None;
+        let mut bytes = Vec::new();
+        for frame in frames {
+            let method = frame["method"].as_str().ok_or("browser_invalid_dispatch")?;
+            if frame["id"].as_u64().is_none() {
+                return Err("browser_invalid_dispatch");
+            }
+            let p = &frame["params"];
+            if maintenance && !maintenance_allowed(method, p) {
+                return Err("browser_maintenance_denied");
+            }
+            if method == "Input.dispatchMouseEvent" {
+                let value = (
+                    frame["sessionId"].clone(),
+                    p["button"].clone(),
+                    p["modifiers"].clone(),
+                );
+                match p["type"].as_str() {
+                    Some("mousePressed") if mouse.is_none() => mouse = Some(value),
+                    Some("mouseReleased") if mouse.as_ref() == Some(&value) => mouse = None,
+                    Some("mouseWheel" | "mouseMoved") => (),
+                    _ => return Err("browser_incomplete_gesture"),
+                }
+            }
+            if method == "Input.dispatchKeyEvent" {
+                let modifiers = p["modifiers"].as_u64().unwrap_or(0);
+                if modifiers & 6 != 0
+                    && matches!(
+                        p["key"].as_str().unwrap_or("").to_lowercase().as_str(),
+                        "c" | "x" | "v"
+                    )
+                {
+                    return Err("browser_clipboard_shortcut_denied");
+                }
+                let value = (
+                    frame["sessionId"].clone(),
+                    p["key"].clone(),
+                    p["modifiers"].clone(),
+                );
+                match p["type"].as_str() {
+                    Some("keyDown" | "rawKeyDown") if key.is_none() => key = Some(value),
+                    Some("keyUp") if key.as_ref() == Some(&value) => key = None,
+                    _ => return Err("browser_incomplete_gesture"),
+                }
+            }
+            if matches!(
+                method,
+                "Input.imeSetComposition" | "Input.dispatchTouchEvent"
+            ) {
+                return Err("browser_gesture_unsupported");
+            }
+            serde_json::to_writer(&mut bytes, frame).map_err(|_| "browser_invalid_dispatch")?;
+            bytes.push(0);
+        }
+        if mouse.is_some() || key.is_some() {
+            return Err("browser_incomplete_gesture");
+        }
+        if bytes.len() > 64 * 1024 {
+            return Err("browser_gesture_limit");
+        }
+        Ok(bytes)
+    }
+}
+fn maintenance_allowed(method: &str, p: &Value) -> bool {
+    match method {
+        "Browser.grantPermissions" => {
+            p["permissions"].as_array().is_some_and(|v| v.is_empty())
+                && p.as_object().is_some_and(|v| v.len() == 1)
+        }
+        "Browser.setDownloadBehavior" => {
+            p["behavior"] == "deny"
+                && p.as_object()
+                    .is_some_and(|v| v.keys().all(|k| k == "behavior" || k == "eventsEnabled"))
+        }
+        "Fetch.continueWithAuth" => {
+            p["authChallengeResponse"]["response"] == "CancelAuth"
+                && p["authChallengeResponse"]
+                    .as_object()
+                    .is_some_and(|v| v.len() == 1)
+        }
+        "Fetch.continueRequest" => p
+            .as_object()
+            .is_some_and(|v| v.len() == 1 && v.contains_key("requestId")),
+        "Page.handleJavaScriptDialog" => {
+            p["accept"] == false && p.as_object().is_some_and(|v| v.len() == 1)
+        }
+        "DOM.setFileInputFiles" => {
+            p["files"].as_array().is_some_and(|v| v.is_empty())
+                && p["backendNodeId"].as_u64().is_some()
+        }
+        "Page.addScriptToEvaluateOnNewDocument" => {
+            let policy: Value = serde_json::from_str(include_str!(
+                "../../../src/modules/browser/platform/desktop/runtime/page-policy.json"
+            ))
+            .unwrap();
+            p["source"] == policy["source"] && p["runImmediately"] == true
+        }
+        _ => matches!(
+            method,
+            "Browser.getVersion"
+                | "Browser.setDownloadBehavior"
+                | "Browser.cancelDownload"
+                | "Target.getTargets"
+                | "Target.setDiscoverTargets"
+                | "Target.setAutoAttach"
+                | "Target.attachToTarget"
+                | "Target.closeTarget"
+                | "Page.enable"
+                | "Page.getFrameTree"
+                | "Page.getLayoutMetrics"
+                | "Page.setInterceptFileChooserDialog"
+                | "Page.captureScreenshot"
+                | "Page.startScreencast"
+                | "Page.stopScreencast"
+                | "Page.screencastFrameAck"
+                | "Runtime.enable"
+                | "Runtime.runIfWaitingForDebugger"
+                | "Runtime.releaseObjectGroup"
+                | "DOM.enable"
+                | "DOM.getDocument"
+                | "DOM.describeNode"
+                | "Network.enable"
+                | "Network.setBlockedURLs"
+                | "Fetch.enable"
+                | "Emulation.setDeviceMetricsOverride"
+        ),
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    fn authority() -> Value {
+        json!({"epoch":1,"leaseId":"l","controllerId":"c","mode":"agent","expiresAt":9999999999999u64})
+    }
+    fn request(frames: Value) -> Value {
+        json!({"lane":"lease","epoch":1,"leaseId":"l","controllerId":"c","frames":frames})
+    }
+    #[test]
+    fn revocation_fences_old_commands() {
+        let mut g = Gate::new("p");
+        g.control(1, Some(&authority())).unwrap();
+        let v = request(json!([{"id":1,"method":"Input.insertText","params":{"text":"x"}}]));
+        assert!(g.admit(&v).is_ok());
+        g.control(2, None).unwrap();
+        assert_eq!(g.admit(&v).unwrap_err(), "browser_stale_control");
+        assert!(g.control(1, Some(&authority())).is_err());
+    }
+    #[test]
+    fn gesture_is_complete_and_same_session() {
+        let mut g = Gate::new("p");
+        g.control(1, Some(&authority())).unwrap();
+        let down = json!({"id":1,"method":"Input.dispatchMouseEvent","sessionId":"a","params":{"type":"mousePressed","button":"left","modifiers":0}});
+        assert!(g.admit(&request(json!([down.clone()]))).is_err());
+        let up = json!({"id":2,"method":"Input.dispatchMouseEvent","sessionId":"a","params":{"type":"mouseReleased","button":"left","modifiers":0}});
+        assert!(g.admit(&request(json!([down.clone(), up.clone()]))).is_ok());
+        let mut bad = up;
+        bad["sessionId"] = json!("b");
+        assert!(g.admit(&request(json!([down, bad]))).is_err());
+    }
+    #[test]
+    fn maintenance_cannot_evaluate_or_grant() {
+        assert!(!maintenance_allowed(
+            "Runtime.evaluate",
+            &json!({"expression":"1"})
+        ));
+        assert!(!maintenance_allowed(
+            "Browser.grantPermissions",
+            &json!({"permissions":["clipboardReadWrite"]})
+        ));
+        assert!(maintenance_allowed(
+            "Browser.grantPermissions",
+            &json!({"permissions":[]})
+        ));
+        assert!(!maintenance_allowed(
+            "Fetch.continueWithAuth",
+            &json!({"authChallengeResponse":{"response":"ProvideCredentials"}})
+        ));
+    }
+}
diff --git a/native/browser-runtime/src/main.rs b/native/browser-runtime/src/main.rs
