+/** Browser-owned domain and process ports. No renderer, Electron or Agent-session objects. */
+export type SpaceKind = 'personal' | 'task';
+export type Retention = 'persistent' | 'ephemeral';
+export type SpaceStatus =
+	| 'provisioning'
+	| 'starting'
+	| 'hydrating'
+	| 'ready'
+	| 'closing'
+	| 'stopped'
+	| 'faulted'
+	| 'quarantined'
+	| 'cleanup_pending';
+export type ControlMode = 'paused' | 'agent' | 'human' | 'quiescing' | 'blocked';
+export type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+
+export interface ControlLease {
+	spaceId: string;
+	runtimeId: string;
+	epoch: number;
+	leaseId: string;
+	controllerId: string;
+	mode: 'agent' | 'human' | 'workspace';
+	expiresAt: number;
+	viewerId?: string;
+	windowId?: string;
+}
+export interface BrowserPage {
+	id: string;
+	spaceId: string;
+	url: string;
+	title: string;
+	documentId: string;
+	status: 'pending' | 'open' | 'failed' | 'closed';
+	error?: string;
+	zoom: number;
+	viewportVersion: number;
+}
+export interface BrowserSpace {
+	id: string;
+	label: string;
+	kind: SpaceKind;
+	retention: Retention;
+	status: SpaceStatus;
+	runtimeId?: string;
+	identityVersionId?: string;
+	pages: BrowserPage[];
+	control: { mode: ControlMode; epoch: number; lease?: ControlLease };
+	createdAt: number;
+	updatedAt: number;
+	error?: string;
+}
+export interface BrowserRun {
+	id: string;
+	spaceId: string;
+	runtimeId: string;
+	issuerId: string;
+	epoch: number;
+	leaseId: string;
+	state: 'active' | 'revoked' | 'stopped';
+	expiresAt: number;
+	externalTaskId?: string;
+}
+export interface RunGrant {
+	run: BrowserRun;
+	capability: string;
+}
+export interface PendingHumanRequest {
+	id: string;
+	spaceId: string;
+	pageId: string;
+	runtimeId: string;
+	documentId: string;
+	epoch: number;
+	revision: number;
+	kind: 'dialog' | 'file-chooser' | 'permission' | 'http-auth';
+	message: string;
+	expiresAt: number;
+	status: 'pending' | 'denied' | 'resolved';
+}
+export interface BrowserFrame {
+	spaceId: string;
+	pageId: string;
+	runtimeId: string;
+	documentId: string;
+	epoch: number;
+	viewportVersion: number;
+	frameId: string;
+	width: number;
+	height: number;
+	cssWidth: number;
+	cssHeight: number;
+	mime: 'image/jpeg' | 'image/png';
+	data: Uint8Array;
+	capturedAt: number;
+	inputSequence: number;
+}
+export type HumanInput =
+	| { kind: 'click'; x: number; y: number; button?: 'left' | 'right' | 'middle'; clickCount?: 1 | 2 }
+	| { kind: 'scroll'; x: number; y: number; deltaX: number; deltaY: number }
+	| { kind: 'key'; key: string; modifiers?: number }
+	| { kind: 'text'; text: string };
+export interface HumanPageRequest {
+	spaceId: string;
+	pageId: string;
+	viewerId: string;
+	leaseId: string;
+	epoch: number;
+}
+export interface SnapshotNode {
+	ref: string;
+	role: string;
+	name: string;
+	value?: string;
+}
+export interface BrowserObservation {
+	id: string;
+	spaceId: string;
+	pageId: string;
+	runtimeId: string;
+	documentId: string;
+	epoch: number;
+	url: string;
+	title: string;
+	nodes: SnapshotNode[];
+	text?: string;
+	truncated: boolean;
+}
+/** All executable page actions are fixed code. Raw JS/CDP and host paths have no public variant. */
+export type BrowserCommand =
+	| { kind: 'navigate'; url: string }
+	| { kind: 'back' | 'forward' | 'reload' | 'stop' | 'snapshot' | 'text' | 'selection' | 'screenshot' }
+	| { kind: 'find'; text: string; forward?: boolean }
+	| { kind: 'click'; observationId: string; ref: string }
+	| { kind: 'fill' | 'type'; observationId: string; ref: string; text: string }
+	| { kind: 'select'; observationId: string; ref: string; values: string[] }
+	| {
+			kind: 'wait';
+			condition: { kind: 'url'; url: string } | { kind: 'text'; text: string } | { kind: 'load' };
+			timeoutMs: number;
+	  }
+	| { kind: 'press'; key: string; modifiers?: number }
+	| { kind: 'scroll'; x: number; y: number; deltaX: number; deltaY: number }
