+	} }));
+	const output = await run(f, ['mcp'], [toolCall(1, 'browser_page_list'), toolCall(2, 'browser_page_list')]);
+	expect(output.code).toBe(0);
+	expect(output.stderr).toBe('');
+	expect(parseReplies(output.stdout)).toEqual([
