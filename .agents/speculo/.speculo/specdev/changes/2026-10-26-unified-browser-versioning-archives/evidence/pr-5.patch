@@ -0,0 +1,37 @@
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { expect, it, vi } from 'vitest';
+import { TestProviders } from '../../../ui/react/test-providers';
+import { t } from '../../../shared/i18n';
+import { CopySelectionButton } from './CopySelectionButton';
+import { workspaceFixture } from './testing/workspace';
+
+it('copies only an explicit bounded selection request and refuses a result after control revocation', async () => {
+	const f = workspaceFixture(),
+		lease = await f.api.takeover({ spaceId: 'space', viewerId: 'viewer', windowId: 'window' });
+	const scope = { spaceId: 'space', pageId: 'page', viewerId: 'viewer', leaseId: lease.leaseId, epoch: lease.epoch };
+	const clipboard = vi.spyOn(navigator.clipboard, 'writeText').mockResolvedValue();
+	const report = vi.fn();
+	const view = render(
+		<TestProviders>
+			<CopySelectionButton api={f.api} authority={() => scope} disabled={false} report={report} />
+		</TestProviders>,
+	);
+	expect(clipboard).not.toHaveBeenCalled();
+	fireEvent.click(screen.getByRole('button', { name: t('browser.v2.copySelection') }));
+	await waitFor(() => expect(clipboard).toHaveBeenCalledWith('selected webpage text'));
+	let finish!: (value: { text: string; truncated: boolean }) => void;
+	vi.mocked(f.api.readSelection).mockImplementation(
+		() =>
+			new Promise((resolve) => {
+				finish = resolve;
+			}),
+	);
+	fireEvent.click(screen.getByRole('button', { name: t('browser.v2.copySelection') }));
+	const state = f.api.getState();
+	f.set({ ...state, spaces: [{ ...state.spaces[0]!, control: { mode: 'paused', epoch: lease.epoch + 1 } }] });
+	await act(async () => finish({ text: 'late selection', truncated: false }));
+	expect(clipboard).toHaveBeenCalledTimes(1);
+	expect(report).toHaveBeenCalledWith(expect.objectContaining({ message: 'control_revoked' }));
+	view.unmount();
+	clipboard.mockRestore();
+});
diff --git a/src/modules/browser/ui/CopySelectionButton.tsx b/src/modules/browser/ui/CopySelectionButton.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..45e24fd6a0ab75c6443054c6cd731ddefa8e702c
--- /dev/null
+++ b/src/modules/browser/ui/CopySelectionButton.tsx
@@ -0,0 +1,86 @@
+import { useEffect, useRef, useState } from 'react';
+import { Copy } from 'lucide-react';
+import type { BrowserWorkspace, HumanPageRequest } from '../api';
+import { Button } from '../../../ui/components/button';
+import { useT } from '../../../ui/react/hooks';
+import { captureHumanPage, sameHumanPage } from './human-authority';
+
+export function CopySelectionButton({
+	api,
+	authority,
+	disabled,
+	report,
+}: {
+	api: BrowserWorkspace;
+	authority: () => HumanPageRequest | undefined;
+	disabled: boolean;
+	report: (reason: unknown) => void;
+}) {
+	const t = useT();
+	const [pending, setPending] = useState(false);
+	const [notice, setNotice] = useState<'empty' | 'copied' | 'truncated'>();
+	const generation = useRef(0),
+		mounted = useRef(false);
+	useEffect(() => {
+		mounted.current = true;
+		generation.current++;
+		return () => {
+			mounted.current = false;
+		};
+	}, [authority]);
+	return (
+		<>
+			<Button
+				size="sm"
+				variant="outline"
+				disabled={disabled || pending}
+				onClick={(event) => {
+					const scope = authority();
+					const page = scope && captureHumanPage(api, scope);
+					const win = event.currentTarget.ownerDocument.defaultView;
+					if (!scope || !page || !win) return;
+					const current = generation.current;
+					setPending(true);
+					setNotice(undefined);
+					void (async () => {
+						try {
+							const selected = await api.readSelection(scope);
+							if (
+								!mounted.current ||
+								generation.current !== current ||
+								!sameHumanPage(api, scope, authority(), page)
+							)
+								throw new Error('control_revoked');
+							if (!selected.text) {
+								setNotice('empty');
+								return;
+							}
+							if (!win.navigator.clipboard?.writeText) throw new Error('clipboard_unavailable');
+							await win.navigator.clipboard.writeText(selected.text);
+							if (mounted.current && generation.current === current)
+								setNotice(selected.truncated ? 'truncated' : 'copied');
+						} catch (reason) {
+							if (mounted.current && generation.current === current) report(reason);
+						} finally {
+							if (mounted.current && generation.current === current) setPending(false);
+						}
+					})();
+				}}
+			>
+				<Copy />
+				{t('browser.v2.copySelection')}
+			</Button>
+			{notice && (
+				<span role="status" className="text-xs text-muted-foreground">
+					{t(
+						notice === 'empty'
+							? 'browser.v2.selectionEmpty'
+							: notice === 'copied'
+								? 'browser.v2.selectionCopied'
+								: 'browser.v2.selectionTruncated',
+					)}
+				</span>
+			)}
+		</>
+	);
+}
