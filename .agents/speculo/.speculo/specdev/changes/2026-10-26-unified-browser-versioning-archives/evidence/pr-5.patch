+					this.current(grant);
+					return result;
+				}
+				if (!grant.allowTaskCreation || grant.created)
+					throw new AgentBrowserError('workspace_create_grant_required');
+				grant.created = true;
+				const creation = (async () => {
+					const space = await this.workspace.createSpace(
