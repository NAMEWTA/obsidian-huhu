+	| { kind: 'upload'; observationId: string; ref: string; fileIds: string[] };
+
+export interface RuntimePage {
+	id: string;
+	url: string;
+	title: string;
+	documentId: string;
+	zoom: number;
+	viewportVersion: number;
+}
+export interface RevocationAck {
