+++ b/native/browser-runtime/src/main.rs
@@ -0,0 +1,363 @@
+mod cookies;
+mod framing;
+mod gate;
+#[cfg(target_os = "linux")]
+mod process;
+mod receipt;
+use serde_json::{json, Value};
+use std::io::{self, Read};
+
+fn main() {
+    let args: Vec<_> = std::env::args().collect();
+    if args.iter().any(|v| v == "--read-cookies") {
+        let mut input = String::new();
+        let read = io::stdin().take(65537).read_to_string(&mut input);
+        let result = if read.is_err() || input.len() > 65536 {
+            Err("browser_reader_request_limit".into())
+        } else {
+            cookies::read_request(&input)
+        };
+        match result {
+            Ok(v) => println!("{v}"),
+            Err(code) => {
+                println!("{}", json!({"error":code}));
+                std::process::exit(1)
+            }
+        }
+        return;
+    }
+    #[cfg(target_os = "linux")]
+    if args.iter().any(|v| v == "--reclaim") {
+        let mut input = String::new();
+        let result = (|| -> io::Result<bool> {
+            io::stdin().take(8193).read_to_string(&mut input)?;
+            if input.len() > 8192 {
+                return Err(io::Error::other("limit"));
+            }
+            let v: Value = serde_json::from_str(&input)?;
+            let p = v["profile"]
+                .as_str()
+                .ok_or_else(|| io::Error::other("profile"))?;
+            let key = v["key"].as_str().ok_or_else(|| io::Error::other("key"))?;
+            process::reclaim(std::path::Path::new(p), v["runtimeId"].as_str(), key)
+        })();
+        println!("{}", json!({"reclaimed":result.unwrap_or(false)}));
+        return;
+    }
+    #[cfg(target_os = "linux")]
+    if run().is_err() {
+        std::process::exit(1)
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = framing::write(
+            &mut io::stdout(),
+            &json!({"type":"fatal","code":"browser_platform_unsupported"}),
+        );
+        std::process::exit(1)
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn run() -> io::Result<()> {
+    use std::fs::File;
+    use std::net::{TcpListener, TcpStream};
+    use std::sync::{
+        atomic::{AtomicBool, Ordering},
+        mpsc, Arc, Mutex,
+    };
+    use std::time::{Duration, Instant};
+    struct Writer {
+        gate: gate::Gate,
+        pipe: File,
+    }
+    let mut stdin = io::stdin().lock();
+    let stdout = Arc::new(Mutex::new(io::stdout()));
+    let start = framing::read(&mut stdin)?.ok_or_else(|| io::Error::other("start_missing"))?;
+    let id = start["id"].clone();
+    if start["type"] != "start" || start["protocol"] != 2 {
+        return Err(io::Error::other("protocol"));
+    }
+    let text = |key: &str| -> io::Result<String> {
+        start[key]
+            .as_str()
+            .map(String::from)
+            .ok_or_else(|| io::Error::other("start_invalid"))
+    };
+    let token = text("token")?;
+    if token.len() != 64 || !token.bytes().all(|v| v.is_ascii_hexdigit()) {
+        return Err(io::Error::other("token_invalid"));
+    }
+    let listener = TcpListener::bind(("127.0.0.1", 0))?;
+    listener.set_nonblocking(true)?;
+    let port = listener.local_addr()?.port();
+    let key = text("ownerKey")?;
+    if key.len() != 64 || !key.bytes().all(|v| v.is_ascii_hexdigit()) {
+        return Err(io::Error::other("owner_key_invalid"));
+    }
+    let ephemeral = start["ephemeral"]
+        .as_bool()
+        .ok_or_else(|| io::Error::other("retention_invalid"))?;
+    let (browser, mut reader, pipe) = match process::Browser::spawn(
+        std::path::Path::new(&text("executable")?),
+        std::path::Path::new(&text("profile")?),
+        &text("runtimeId")?,
+        &text("spaceId")?,
+        ephemeral,
+        &key,
+    ) {
+        Ok(v) => v,
+        Err(_) => {
+            framing::write(
+                &mut *stdout.lock().unwrap(),
+                &json!({"id":id,"error":"browser_start_failed"}),
+            )?;
+            return Err(io::Error::other("start_failed"));
+        }
+    };
+    let browser = Arc::new(browser);
+    let writer = Arc::new(Mutex::new(Writer {
+        gate: gate::Gate::new(&text("provisioningLease")?),
+        pipe,
+    }));
+    let ending = Arc::new(AtomicBool::new(false));
+    let control_pending = Arc::new(AtomicBool::new(false));
+    let (send, receive) = mpsc::sync_channel::<Value>(128);
+    let fatal: Arc<dyn Fn(&str) + Send + Sync> = {
+        let ending = ending.clone();
+        let browser = browser.clone();
+        let writer = writer.clone();
+        let stdout = stdout.clone();
+        Arc::new(move |code| {
+            if !ending.swap(true, Ordering::SeqCst) {
+                writer.lock().unwrap().gate.closed = true;
+                let _ = browser.stop();
+                let _ = framing::write(
+                    &mut *stdout.lock().unwrap(),
+                    &json!({"type":"fatal","code":code}),
+                );
+            }
+        })
+    };
+    {
+        let send = send.clone();
+        let fatal = fatal.clone();
+        let ending = ending.clone();
+        std::thread::spawn(move || {
+            let mut pending = Vec::new();
+            let mut buffer = [0u8; 8192];
+            while !ending.load(Ordering::SeqCst) {
+                let size = match reader.read(&mut buffer) {
+                    Ok(0) => break,
+                    Ok(n) => n,
+                    Err(_) => break,
+                };
+                for byte in &buffer[..size] {
+                    if *byte == 0 {
+                        if !pending.is_empty() {
+                            match serde_json::from_slice::<Value>(&pending) {
+                                Ok(v) => {
+                                    if send.try_send(json!({"type":"cdp","message":v})).is_err() {
+                                        fatal("browser_transport_backpressure");
+                                        return;
+                                    }
+                                }
+                                Err(_) => {
+                                    fatal("browser_protocol_failed");
+                                    return;
+                                }
+                            };
+                            pending.clear();
+                        }
+                    } else {
+                        pending.push(*byte);
+                        if pending.len() > framing::MAX {
+                            fatal("browser_frame_limit");
+                            return;
+                        }
+                    }
+                }
+            }
+            fatal("browser_process_closed");
+        });
+    }
+    {
+        let fatal = fatal.clone();
+        let writer = writer.clone();
+        let ending = ending.clone();
+        let control_pending = control_pending.clone();
+        std::thread::spawn(move || {
+            let began = Instant::now();
+            let mut accepted: Option<TcpStream> = None;
+            while began.elapsed() < Duration::from_secs(15) && !ending.load(Ordering::SeqCst) {
+                match listener.accept() {
+                    Ok((mut socket, _)) => {
+                        let _ = socket.set_nodelay(true);
+                        let _ = socket.set_read_timeout(Some(Duration::from_secs(2)));
+                        let _ = socket.set_write_timeout(Some(Duration::from_secs(2)));
+                        if framing::read(&mut socket)
+                            .ok()
+                            .flatten()
+                            .is_some_and(|v| v["token"] == token)
+                        {
+                            accepted = Some(socket);
+                            break;
+                        }
+                    }
+                    Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                        std::thread::sleep(Duration::from_millis(10))
+                    }
+                    Err(_) => break,
+                }
+            }
+            let Some(mut socket) = accepted else {
+                fatal("browser_worker_missing");
+                return;
+            };
+            let _ = socket.set_read_timeout(None);
+            let output = match socket.try_clone() {
+                Ok(v) => v,
+                Err(_) => {
+                    fatal("browser_transport_failed");
+                    return;
+                }
+            };
+            let output = Arc::new(Mutex::new(output));
+            {
+                let output = output.clone();
+                let fatal = fatal.clone();
+                let ending = ending.clone();
+                std::thread::spawn(move || {
+                    while !ending.load(Ordering::SeqCst) {
+                        match receive.recv_timeout(Duration::from_millis(100)) {
+                            Ok(v) => {
+                                if framing::write(&mut *output.lock().unwrap(), &v).is_err() {
+                                    fatal("browser_worker_backpressure");
+                                    return;
+                                }
+                            }
+                            Err(mpsc::RecvTimeoutError::Timeout) => (),
+                            Err(_) => break,
+                        }
+                    }
+                });
+            }
+            while !ending.load(Ordering::SeqCst) {
+                let request = match framing::read(&mut socket) {
+                    Ok(Some(v)) => v,
+                    _ => break,
+                };
+                let id = request["id"].clone();
+                let result = (|| -> Result<u64, &str> {
+                    if control_pending.load(Ordering::SeqCst) {
+                        return Err("browser_control_pending");
+                    }
+                    let mut state = writer.lock().map_err(|_| "browser_transport_failed")?;
+                    if control_pending.load(Ordering::SeqCst) {
+                        return Err("browser_control_pending");
+                    }
+                    let bytes = state.gate.admit(&request)?;
+                    if process::bounded_write(&mut state.pipe, &bytes).is_err() {
+                        state.gate.closed = true;
+                        return Err("outcome_unknown");
+                    }
+                    state.gate.sequence += 1;
+                    Ok(state.gate.sequence)
+                })();
+                let response = match result {
+                    Ok(sequence) => json!({"type":"dispatch","id":id,"sequence":sequence}),
+                    Err(code) => json!({"type":"dispatch","id":id,"error":code}),
+                };
+                if framing::write(&mut *output.lock().unwrap(), &response).is_err() {
+                    break;
+                }
+                if result == Err("outcome_unknown") {
+                    fatal("outcome_unknown");
+                    return;
+                }
+            }
+            fatal("browser_worker_closed");
+        });
+    }
+    framing::write(
+        &mut *stdout.lock().unwrap(),
+        &json!({"id":id,"result":{"protocol":2,"port":port,"pid":browser.pid,"birth":browser.birth}}),
+    )?;
+    loop {
+        let request = match framing::read(&mut stdin) {
+            Ok(Some(value)) => value,
+            _ => break,
+        };
+        let id = request["id"].clone();
+        match request["type"].as_str() {
+            Some("control") => {
+                control_pending.store(true, Ordering::SeqCst);
+                let result = (|| -> Result<Value, &str> {
+                    let epoch = request["epoch"]
+                        .as_u64()
+                        .filter(|v| *v <= 1000000000)
+                        .ok_or("browser_invalid_control")?;
+                    let lease = if request["lease"].is_null() {
+                        None
+                    } else {
+                        Some(&request["lease"])
+                    };
+                    if lease.is_some_and(|v| v["runtimeId"] != browser.runtime) {
+                        return Err("browser_invalid_control");
+                    }
+                    let mut state = writer.lock().map_err(|_| "browser_transport_failed")?;
+                    let renewing = epoch == state.gate.epoch;
+                    state.gate.control(epoch, lease)?;
+                    // Deny first, even if the Worker is wedged. A valid new lease may
+                    // subsequently enable its private download directory through Worker policy.
+                    if !renewing {
+                        let mut bytes=serde_json::to_vec(&json!({"id":900000000+epoch,"method":"Browser.setDownloadBehavior","params":{"behavior":"deny","eventsEnabled":true}})).unwrap();
+                        bytes.push(0);
+                        if process::bounded_write(&mut state.pipe, &bytes).is_err() {
+                            state.gate.closed = true;
+                            return Err("outcome_unknown");
+                        }
+                        state.gate.sequence += 1;
+                    }
+                    Ok(
+                        json!({"epoch":state.gate.epoch,"lastDispatchedSequence":state.gate.sequence,"transportState":"open"}),
+                    )
+                })();
+                control_pending.store(false, Ordering::SeqCst);
+                let response = match result {
+                    Ok(ref value) => json!({"id":id,"result":value}),
+                    Err(code) => json!({"id":id,"error":code}),
+                };
+                framing::write(&mut *stdout.lock().unwrap(), &response)?;
+                if result == Err("outcome_unknown") {
+                    fatal("outcome_unknown");
+                    break;
+                }
+            }
+            Some("stop") => {
+                control_pending.store(true, Ordering::SeqCst);
+                ending.store(true, Ordering::SeqCst);
+                writer.lock().unwrap().gate.closed = true;
+                let reclaimed = browser.stop().unwrap_or(false);
+                framing::write(
+                    &mut *stdout.lock().unwrap(),
+                    &json!({"id":id,"result":{"reclaimed":reclaimed}}),
+                )?;
+                if reclaimed {
+                    return Ok(());
+                } // A failed stop remains retryable on this independent lane.
+            }
+            _ => framing::write(
+                &mut *stdout.lock().unwrap(),
+                &json!({"id":id,"error":"browser_invalid_control"}),
+            )?,
+        }
+    }
+    ending.store(true, Ordering::SeqCst);
+    writer.lock().unwrap().gate.closed = true;
+    if browser.stop()? {
+        Ok(())
+    } else {
+        Err(io::Error::other("cleanup_pending"))
+    }
+}
diff --git a/native/browser-runtime/src/process.rs b/native/browser-runtime/src/process.rs
new file mode 100644
index 0000000000000000000000000000000000000000..eedf503b03aad29631d9ba53e8fc89850c8085c1
--- /dev/null
+++ b/native/browser-runtime/src/process.rs
@@ -0,0 +1,309 @@
+use serde_json::json;
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Write};
+use std::os::fd::{AsRawFd, FromRawFd, RawFd};
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::os::unix::process::CommandExt;
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::sync::Mutex;
+use std::time::{Duration, Instant};
+
+pub struct Browser {
+    pub pid: u32,
+    pub birth: String,
+    pub profile: PathBuf,
+    pub runtime: String,
+    key: String,
+    child: Mutex<Child>,
+    stop: Mutex<()>,
+}
+fn pair() -> io::Result<(File, File)> {
+    let mut fds = [-1; 2];
+    if unsafe { libc::pipe2(fds.as_mut_ptr(), libc::O_CLOEXEC) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { (File::from_raw_fd(fds[0]), File::from_raw_fd(fds[1])) })
+}
+fn duplicate(fd: RawFd) -> io::Result<File> {
+    let n = unsafe { libc::fcntl(fd, libc::F_DUPFD_CLOEXEC, 10) };
+    if n < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(unsafe { File::from_raw_fd(n) })
+    }
+}
+pub fn birth(pid: u32) -> io::Result<Option<String>> {
+    match fs::read_to_string(format!("/proc/{pid}/stat")) {
+        Ok(v) => {
+            let tail = v
+                .rsplit_once(')')
+                .ok_or_else(|| io::Error::other("process_identity"))?
+                .1;
+            Ok(Some(
+                tail.split_whitespace()
+                    .nth(19)
+                    .ok_or_else(|| io::Error::other("process_identity"))?
+                    .into(),
+            ))
+        }
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(e) => Err(e),
+    }
+}
+fn live_group(pid: u32) -> io::Result<bool> {
+    for entry in fs::read_dir("/proc")? {
+        let entry = entry?;
+        if entry.file_name().to_string_lossy().parse::<u32>().is_err() {
+            continue;
+        }
+        let raw = match fs::read_to_string(entry.path().join("stat")) {
+            Ok(v) => v,
+            Err(e) if e.kind() == io::ErrorKind::NotFound => continue,
+            Err(e) => return Err(e),
+        };
+        let Some((_, tail)) = raw.rsplit_once(')') else {
+            return Err(io::Error::other("process_identity"));
+        };
+        let fields: Vec<_> = tail.split_whitespace().collect();
+        if fields.get(2).and_then(|v| v.parse::<u32>().ok()) == Some(pid)
+            && fields.first() != Some(&"Z")
+        {
+            return Ok(true);
+        }
+    }
+    Ok(false)
+}
+fn signal_group(pid: u32, signal: i32) -> io::Result<()> {
+    if unsafe { libc::kill(-(pid as i32), signal) } < 0 {
+        let e = io::Error::last_os_error();
+        if e.raw_os_error() != Some(libc::ESRCH) {
+            return Err(e);
+        }
+    }
+    Ok(())
+}
+fn reclaim_group(pid: u32, expected: &str) -> io::Result<bool> {
+    if birth(pid)?.is_some_and(|actual| actual != expected) {
+        return Ok(true);
+    }
+    signal_group(pid, libc::SIGTERM)?;
+    let began = Instant::now();
+    while began.elapsed() < Duration::from_secs(3) {
+        if !live_group(pid)? {
+            return Ok(true);
+        }
+        if began.elapsed() > Duration::from_millis(150) {
+            signal_group(pid, libc::SIGKILL)?;
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    Ok(!live_group(pid)?)
+}
+fn receipt(profile: &Path) -> PathBuf {
+    profile.join(".huhu-runtime-owner.json")
+}
+pub fn reclaim(profile: &Path, expected_runtime: Option<&str>, key: &str) -> io::Result<bool> {
+    if !profile.is_absolute() || fs::canonicalize(profile)? != profile {
+        return Err(io::Error::other("owner_path_invalid"));
+    }
+    let file = receipt(profile);
+    let metadata = match fs::symlink_metadata(&file) {
+        Ok(v) => v,
+        Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(true),
+        Err(e) => return Err(e),
+    };
+    if !metadata.is_file() || metadata.len() > 8192 {
+        return Err(io::Error::other("owner_invalid"));
+    }
+    let data = fs::read(&file)?;
+    let owner = crate::receipt::open(&data, key)?;
+    let runtime = owner["runtimeId"]
+        .as_str()
+        .ok_or_else(|| io::Error::other("owner_invalid"))?;
+    if expected_runtime.is_some_and(|v| v != runtime) {
+        return Err(io::Error::other("owner_mismatch"));
+    }
+    let pid = owner["pid"]
+        .as_u64()
+        .filter(|v| *v > 1 && *v <= i32::MAX as u64)
+        .ok_or_else(|| io::Error::other("owner_invalid"))? as u32;
+    let expected = owner["birth"]
+        .as_str()
+        .filter(|v| !v.is_empty() && v.bytes().all(|c| c.is_ascii_digit()))
+        .ok_or_else(|| io::Error::other("owner_invalid"))?;
+    if !reclaim_group(pid, expected)? {
+        return Ok(false);
+    }
+    if fs::read(&file)? != data {
+        return Err(io::Error::other("owner_changed"));
+    }
+    fs::remove_file(file)?;
+    Ok(true)
+}
+impl Browser {
+    pub fn spawn(
+        executable: &Path,
+        profile: &Path,
+        runtime: &str,
+        space: &str,
+        ephemeral: bool,
+        key: &str,
+    ) -> io::Result<(Self, File, File)> {
+        if !profile.is_absolute()
+            || !executable.is_absolute()
+            || fs::symlink_metadata(profile)?.file_type().is_symlink()
+            || receipt(profile).exists()
+        {
+            return Err(io::Error::other("owned_profile_required"));
+        }
+        fs::set_permissions(profile, fs::Permissions::from_mode(0o700))?;
+        let (input, writer) = pair()?;
+        let (reader, output) = pair()?;
+        let input = duplicate(input.as_raw_fd())?;
+        let output = duplicate(output.as_raw_fd())?;
+        let in_fd = input.as_raw_fd();
+        let out_fd = output.as_raw_fd();
+        let parent = unsafe { libc::getpid() };
+        unsafe {
+            libc::prctl(libc::PR_SET_CHILD_SUBREAPER, 1);
+        }
+        let mut command = Command::new(executable);
+        command
+            .args([
+                "--headless=new",
+                "--remote-debugging-pipe",
+                "--no-first-run",
+                "--no-default-browser-check",
+                "--disable-sync",
+                "--disable-background-networking",
+                "--disable-dev-shm-usage",
+            ])
+            .arg(format!("--user-data-dir={}", profile.display()))
+            .arg("about:blank")
+            .env_clear()
+            .env("PATH", "/usr/bin:/bin")
+            .env("LANG", "C.UTF-8")
+            .env("HOME", profile)
+            .env("XDG_CONFIG_HOME", profile)
+            .stdin(Stdio::null())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null());
+        unsafe {
+            command.pre_exec(move || {
+                if libc::setsid() < 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                if libc::prctl(libc::PR_SET_PDEATHSIG, libc::SIGKILL) < 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                if libc::getppid() != parent {
+                    libc::_exit(127);
+                }
+                if libc::dup2(in_fd, 3) < 0 || libc::dup2(out_fd, 4) < 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                Ok(())
+            });
+        }
+        let mut child = command.spawn()?;
+        let pid = child.id();
+        let born = match birth(pid) {
+            Ok(Some(v)) => v,
+            Ok(None) => {
+                let _ = child.wait();
+                return Err(io::Error::other("browser_exited"));
+            }
+            Err(error) => {
+                let _ = signal_group(pid, libc::SIGKILL);
+                let _ = child.wait();
+                return Err(error);
+            }
+        };
+        let browser = Self {
+            pid,
+            birth: born,
+            profile: profile.into(),
+            runtime: runtime.into(),
+            key: key.into(),
+            child: Mutex::new(child),
+            stop: Mutex::new(()),
+        };
+        let record = crate::receipt::seal(
+            json!({"version":2,"spaceId":space,"ephemeral":ephemeral,"runtimeId":runtime,"pid":pid,"birth":browser.birth}),
+            key,
+        )?;
+        let saved = (|| -> io::Result<()> {
+            let mut file = OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(receipt(profile))?;
+            file.write_all(&serde_json::to_vec(&record)?)?;
+            file.sync_all()?;
+            File::open(profile)?.sync_all()
+        })();
+        if let Err(e) = saved {
+            let _ = signal_group(pid, libc::SIGKILL);
+            let _ = browser.child.lock().unwrap().wait();
+            return Err(e);
+        }
+        let flags = unsafe { libc::fcntl(writer.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0
+            || unsafe { libc::fcntl(writer.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) }
+                < 0
+        {
+            let _ = browser.stop();
+            return Err(io::Error::last_os_error());
+        }
+        Ok((browser, reader, writer))
+    }
+    pub fn stop(&self) -> io::Result<bool> {
+        let _guard = self
+            .stop
+            .lock()
+            .map_err(|_| io::Error::other("stop_poisoned"))?;
+        let reclaimed = reclaim_group(self.pid, &self.birth)?;
+        let _ = self.child.lock().unwrap().try_wait();
+        unsafe {
+            while libc::waitpid(-(self.pid as i32), std::ptr::null_mut(), libc::WNOHANG) > 0 {}
+        }
+        if reclaimed && receipt(&self.profile).exists() {
+            let data = fs::read(receipt(&self.profile))?;
+            let v = crate::receipt::open(&data, &self.key)?;
+            if v["runtimeId"] != self.runtime
+                || v["pid"].as_u64() != Some(self.pid as u64)
+                || v["birth"] != self.birth
+            {
+                return Err(io::Error::other("owner_changed"));
+            }
+            fs::remove_file(receipt(&self.profile))?;
+        }
+        Ok(reclaimed)
+    }
+}
+pub fn bounded_write(writer: &mut File, bytes: &[u8]) -> io::Result<()> {
+    let begin = Instant::now();
+    let mut offset = 0;
+    while offset < bytes.len() {
+        match writer.write(&bytes[offset..]) {
+            Ok(0) => return Err(io::Error::other("pipe_closed")),
+            Ok(n) => offset += n,
+            Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                if begin.elapsed() > Duration::from_millis(150) {
+                    return Err(io::Error::new(io::ErrorKind::TimedOut, "outcome_unknown"));
+                }
+                let mut fd = libc::pollfd {
+                    fd: writer.as_raw_fd(),
+                    events: libc::POLLOUT,
+                    revents: 0,
+                };
+                unsafe {
+                    libc::poll(&mut fd, 1, 5);
+                }
+            }
+            Err(e) => return Err(e),
+        }
+    }
+    Ok(())
+}
diff --git a/native/browser-runtime/src/receipt.rs b/native/browser-runtime/src/receipt.rs
new file mode 100644
index 0000000000000000000000000000000000000000..80cd5e1bdea0f3d87596e72167769d7a71072f52
--- /dev/null
+++ b/native/browser-runtime/src/receipt.rs
@@ -0,0 +1,60 @@
+use hmac::{Hmac, Mac};
+use serde_json::{json, Value};
+use sha2::Sha256;
+use std::io;
+fn decode(value: &str) -> io::Result<Vec<u8>> {
+    if value.len() != 64 || !value.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(io::Error::other("owner_key_invalid"));
+    }
+    (0..value.len())
+        .step_by(2)
+        .map(|index| {
+            u8::from_str_radix(&value[index..index + 2], 16)
+                .map_err(|_| io::Error::other("owner_key_invalid"))
+        })
+        .collect()
+}
+pub fn seal(data: Value, key: &str) -> io::Result<Value> {
+    let mut mac = Hmac::<Sha256>::new_from_slice(&decode(key)?)
+        .map_err(|_| io::Error::other("owner_key_invalid"))?;
+    mac.update(&serde_json::to_vec(&data)?);
+    let signature = mac
+        .finalize()
+        .into_bytes()
+        .iter()
+        .map(|v| format!("{v:02x}"))
+        .collect::<String>();
+    Ok(json!({"data":data,"mac":signature}))
+}
+pub fn open(bytes: &[u8], key: &str) -> io::Result<Value> {
+    let envelope: Value = serde_json::from_slice(bytes)?;
+    let data = &envelope["data"];
+    let mut mac = Hmac::<Sha256>::new_from_slice(&decode(key)?)
+        .map_err(|_| io::Error::other("owner_key_invalid"))?;
+    mac.update(&serde_json::to_vec(data)?);
+    mac.verify_slice(&decode(envelope["mac"].as_str().unwrap_or(""))?)
+        .map_err(|_| io::Error::other("owner_authentication_failed"))?;
+    if data["version"] != 2
+        || data["ephemeral"].as_bool().is_none()
+        || data["spaceId"].as_str().is_none()
+    {
+        return Err(io::Error::other("owner_invalid"));
+    }
+    Ok(data.clone())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn receipts_reject_tampering() {
+        let key = "ab".repeat(32);
+        let data = json!({"version":2,"ephemeral":true,"spaceId":"space","pid":20});
+        let mut value = seal(data.clone(), &key).unwrap();
+        assert_eq!(
+            open(&serde_json::to_vec(&value).unwrap(), &key).unwrap(),
+            data
+        );
+        value["data"]["pid"] = json!(21);
+        assert!(open(&serde_json::to_vec(&value).unwrap(), &key).is_err());
+    }
+}
