+		root,
+		persistence,
+		runtimeFactory,
+		credentials,
+		scheduleInterval(callback: () => void, milliseconds: number) {
+			const timer = nodeSetInterval(callback, milliseconds);
+			return () => nodeClearInterval(timer);
+		},
+		async listSources(): Promise<IdentitySource[]> {
+			await assertOwner();
