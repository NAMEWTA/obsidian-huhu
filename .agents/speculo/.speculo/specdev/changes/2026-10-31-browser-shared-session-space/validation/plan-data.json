    [
      "F04",
      "宿主桥",
      "主进程 Session、guest WebContents、输入、截图、权限和销毁能力能通过窄桥使用，缺失时明确失败"
    ],
    [
      "F05",
      "安全",
      "在网页第一次加载前固定 guest 安全配置、导航/新窗口和权限策略；不能导航后再补保护"
    ],
    [
      "F06",
      "人机共作",
      "人工在页面输入/登录，Agent 对同一 webContentsId 操作，接管不换页面、不刷新、不复制登录态"
    ],
    [
      "F07",
      "真实交互",
      "中文 IME、焦点、滚动、选区、缩放、文件选择、网页对话框、常见登录跳转均有结果"
    ],
    [
      "F08",
      "弹窗认证",
      "受控 popup/新页保持正确 Session；需要 opener/postMessage 的认证流程不因简单“取消后另开 URL”被破坏"
    ],
    [
      "F09",
      "生命周期",
      "切标签、隐藏、关闭、React 更新、模块停用、guest 崩溃与宿主退出没有重复实例、泄漏或假成功"
    ],
    [
      "F10",
      "控制屏障",
      "人工接管优先于等待中的 Agent 队列；旧凭据、迟到响应和已过期元素引用失效"
    ],
    [
      "F11",
      "删除",
      "在 guest、下载及网站后台活动收敛后清理指定 Session，验证已清范围与残留，不触及其他 partition"
    ],
    [
      "F12",
      "多窗口",
      "验证同页第二入口、窗口关闭和页面归属；不能用重建 URL 冒充无损迁移"
