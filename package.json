		"eslint-plugin-react-hooks": "7.0.0",
		"globals": "14.0.0",
		"happy-dom": "20.14.5",
		"jiti": "2.6.1",
		"linkedom": "^0.18.13",
		"postcss": "8.5.6",
		"prettier": "^3.6.2",
		"stylelint": "^17.16.0",
		"tailwindcss": "4.1.13",
		"tslib": "2.4.0",
		"tw-animate-css": "1.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.62.1",
		"vitest": "^5.0.3"
	},
