{
	"name": "obsidian-huhu",
	"version": "0.0.1",
	"description": "HUHU — dashboards, comments, coding agents, icons, contacts, automations and notifications.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"generate:pi-profiles": "node scripts/generate-pi-artifact-profiles.mjs",
		"test:build-text": "node scripts/verify-build-text.mjs",
		"dev": "node scripts/dev.mjs",
		"build": "tsc -noEmit -skipLibCheck && tsc -skipLibCheck -p tsconfig.test.json && node scripts/build-tailwind.mjs && node scripts/build-styles.mjs --check && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:weather-mapping": "esbuild scripts/verify-weather-mapping.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-weather-mapping.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-weather-mapping.cjs",
		"test:folder-tag-search": "esbuild scripts/verify-folder-tag-search.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-folder-tag-search.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-folder-tag-search.cjs",
		"test:visible-properties": "esbuild scripts/verify-visible-properties.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-visible-properties.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-visible-properties.cjs",
		"test:calendar-task-insert": "esbuild scripts/verify-calendar-task-insert.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-calendar-task-insert.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-calendar-task-insert.cjs",
		"test:calendar-daynum": "esbuild scripts/verify-calendar-daynum.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-calendar-daynum.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-calendar-daynum.cjs",
		"test:calendar-section": "esbuild scripts/verify-calendar-section.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-calendar-section.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-calendar-section.cjs",
		"test:path-picker": "esbuild scripts/verify-path-picker.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-path-picker.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-path-picker.cjs",
		"test:library-cover": "esbuild scripts/verify-library-cover.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-library-cover.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-library-cover.cjs",
		"test:kanban-upgrade": "esbuild scripts/verify-kanban-upgrade.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-kanban-upgrade.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-kanban-upgrade.cjs",
		"test:pair-width": "esbuild scripts/verify-pair-width.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-pair-width.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-pair-width.cjs",
		"test:library-card-size": "esbuild scripts/verify-library-card-size.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-library-card-size.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-library-card-size.cjs",
		"test:media-thumb-size": "esbuild scripts/verify-media-thumb-size.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-media-thumb-size.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-media-thumb-size.cjs",
		"test:library-group": "esbuild scripts/verify-library-group.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-library-group.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-library-group.cjs",
		"test:countdown-picker": "esbuild scripts/verify-countdown-picker.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-countdown-picker.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-countdown-picker.cjs",
		"test:gallery-placeholder": "esbuild scripts/verify-gallery-placeholder.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-gallery-placeholder.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-gallery-placeholder.cjs",
		"test:album-widget": "esbuild scripts/verify-album-widget.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-album-widget.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-album-widget.cjs",
		"test:doc-bracket-paths": "esbuild scripts/verify-doc-bracket-paths.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-doc-bracket-paths.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-doc-bracket-paths.cjs",
		"test:property-operator": "esbuild scripts/verify-property-operator.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-property-operator.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-property-operator.cjs",
		"test:library-new-note": "esbuild scripts/verify-library-new-note.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-library-new-note.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-library-new-note.cjs",
		"test:web-section": "esbuild scripts/verify-web-section.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-web-section.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-web-section.cjs",
		"test:card-move": "esbuild scripts/verify-card-move.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-card-move.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-card-move.cjs",
		"test:music-account": "esbuild scripts/verify-music-account.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-music-account.cjs --alias:obsidian=./scripts/music-network-stub.ts --alias:electron=./scripts/music-electron-stub.ts --alias:@electron/remote=./scripts/music-electron-stub.ts --log-level=warning && node node_modules/.tmp/verify-music-account.cjs",
		"test:music-client": "esbuild scripts/verify-music-client.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-music-client.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-music-client.cjs",
		"test:card-new-note": "esbuild scripts/verify-card-new-note.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-card-new-note.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-card-new-note.cjs",
		"test:memo-markdown": "esbuild scripts/verify-memo-markdown.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-memo-markdown.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-memo-markdown.cjs",
		"test:expense": "esbuild scripts/verify-expense.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-expense.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-expense.cjs",
		"test:refresh-scope": "esbuild scripts/verify-refresh-scope.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-refresh-scope.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-refresh-scope.cjs",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\"",
		"test:issue-regressions": "esbuild scripts/verify-issue-regressions.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-issue-regressions.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-issue-regressions.cjs",
		"accept:contacts-scale": "esbuild scripts/accept-contacts-scale.ts --bundle --platform=node --format=cjs --outfile=scripts/tmp/accept-contacts-scale.cjs --alias:obsidian=./scripts/obsidian-stub.ts --loader:.md=text --log-level=warning && node --expose-gc scripts/tmp/accept-contacts-scale.cjs",
		"test:promise-callbacks": "node scripts/verify-promise-callbacks.mjs",
		"test:architecture": "node scripts/verify-architecture.mjs",
		"test:dashboard-isolation": "esbuild scripts/verify-dashboard-isolation.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-dashboard-isolation.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-dashboard-isolation.cjs",
		"test:card-panels": "esbuild scripts/verify-card-panels.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/verify-card-panels.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node node_modules/.tmp/verify-card-panels.cjs",
		"test:safety-regressions": "node scripts/run-safety-regressions.mjs",
		"test:all": "node scripts/run-all-tests.mjs",
		"test:reliability": "esbuild scripts/verify-reliability.ts --bundle --platform=node --format=cjs --outfile=scripts/tmp/verify-reliability.cjs --alias:obsidian=./scripts/obsidian-stub.ts --log-level=warning && node --test scripts/tmp/verify-reliability.cjs",
		"test:i18n": "node scripts/verify-i18n.mjs",
		"test:docs": "node scripts/verify-docs.mjs",
		"test:workbench-lifecycle": "esbuild scripts/verify-workbench-lifecycle.ts --bundle --platform=node --format=cjs --outfile=scripts/tmp/verify-workbench-lifecycle.cjs --log-level=warning && node --test scripts/tmp/verify-workbench-lifecycle.cjs",
		"test:workbench-entry": "node --test scripts/verify-workbench-entry.mjs",
		"test:styles": "node scripts/build-tailwind.mjs && node scripts/build-styles.mjs --check",
		"check:bundle": "node scripts/check-bundle.mjs --budget scripts/bundle-budget.json --enforce",
		"check:styles": "node scripts/check-styles.mjs",
		"test:unit": "vitest run",
		"check:similarity": "node scripts/check-similarity.mjs",
		"check:native": "cargo test --locked --manifest-path native/pty-server/Cargo.toml",
		"check:notices": "node scripts/third-party-notices.mjs --check",
		"notices": "node scripts/third-party-notices.mjs --write",
		"lint:css": "node scripts/lint-css.mjs",
		"build:css": "node scripts/build-tailwind.mjs && node scripts/build-styles.mjs --write",
		"test:ui-styles": "node scripts/verify-ui-styles.mjs",
		"test:ui-adapters": "node scripts/verify-ui-adapters.mjs",
		"test:ui-runtime": "node scripts/verify-ui-runtime.mjs",
		"test:license-texts": "node --test scripts/license-texts.test.mjs"
	},
	"keywords": [],
	"license": "SEE LICENSE IN LICENSE",
	"packageManager": "pnpm@11.1.3",
