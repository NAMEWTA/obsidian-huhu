[
  { "name": "未加类名的按钮被中和", "selector": "#plain-button", "expect": { "background-color": { "equals": "rgba(0, 0, 0, 0)" }, "box-shadow": { "equals": "none" }, "padding-left": { "equals": "0px" } } },
  { "name": "ghost 按钮常态透明", "selector": "#ghost-button", "expect": { "background-color": { "equals": "rgba(0, 0, 0, 0)" }, "box-shadow": { "equals": "none" } } },
  { "name": "ghost 按钮悬停有底色", "selector": "#ghost-button", "state": ["hover"], "expect": { "background-color": { "not": "rgba(0, 0, 0, 0)" } } },
  { "name": "原生 Markdown 按钮不被中和", "selector": "#md-button", "expect": { "padding-left": { "not": "0px" }, "box-shadow": { "not": "none" } } },
  { "name": "原生复选框保留边框", "selector": "#native-checkbox", "expect": { "border-top-width": { "equals": "1px" } } },
  { "name": "长中文按钮不溢出且显示省略号", "selector": "#fx-long-zh", "check": "const box=document.querySelector('#fx-box-200').getBoundingClientRect(),r=el.getBoundingClientRect(),span=el.querySelector(':scope > span');return r.right<=box.right+1&&el.scrollWidth<=el.clientWidth+1&&span.scrollWidth>span.clientWidth&&getComputedStyle(span).textOverflow==='ellipsis';" },
  { "name": "带图标长按钮不溢出且图标不缩小", "selector": "#fx-long-zh-icon", "check": "const box=document.querySelector('#fx-box-200').getBoundingClientRect(),r=el.getBoundingClientRect();return r.right<=box.right+1&&el.scrollWidth<=el.clientWidth+1&&Math.round(el.querySelector('svg').getBoundingClientRect().width)===16;" },
  { "name": "长英文按钮不溢出", "selector": "#fx-long-en", "check": "const box=document.querySelector('#fx-box-200').getBoundingClientRect();return el.getBoundingClientRect().right<=box.right+1&&el.scrollWidth<=el.clientWidth+1;" },
  { "name": "显式换行按钮保留完整标签", "selector": "#fx-wrapping", "check": "const span=el.querySelector(':scope > span');return el.getBoundingClientRect().height>=40&&el.scrollWidth<=el.clientWidth+1&&span.scrollWidth<=span.clientWidth+1;" },
  { "name": "短标签保持自然宽度", "selector": "#fx-short", "check": "const span=el.querySelector(':scope > span');return el.getBoundingClientRect().width<=80&&span.scrollWidth<=span.clientWidth;" },
  { "name": "实际 secondary 按钮遵循 32px HU 控件高度", "selector": "#fx-short", "expect": { "height": { "equals": "32px" }, "border-top-width": { "equals": "1px" } } },
  { "name": "paper 嵌套表面别名", "selector": "#nested-ui", "surfaceTheme": "paper", "colorEquals": { "backgroundColor": "#2C6669", "color": "#A93A2A" } },
  { "name": "paper 独立 Portal 别名", "selector": "#standalone-ui", "surfaceTheme": "paper", "colorEquals": { "backgroundColor": "#2C6669", "color": "#A93A2A" } },
  { "name": "ink 嵌套表面别名", "selector": "#nested-ui", "surfaceTheme": "ink", "colorEquals": { "backgroundColor": "#6FB4AF", "color": "#EE8B7B" } },
  { "name": "ink 独立 Portal 别名", "selector": "#standalone-ui", "surfaceTheme": "ink", "colorEquals": { "backgroundColor": "#6FB4AF", "color": "#EE8B7B" } },
  { "name": "paper 图表强调色", "selector": "#chart-sample-1", "surfaceTheme": "paper", "colorEquals": { "backgroundColor": "#2C6669" } },
  { "name": "paper 图表第五色", "selector": "#chart-sample-5", "surfaceTheme": "paper", "colorEquals": { "backgroundColor": "#6E8BA8" } },
  { "name": "ink 图表强调色", "selector": "#chart-sample-1", "surfaceTheme": "ink", "colorEquals": { "backgroundColor": "#6FB4AF" } },
  { "name": "ink 图表第五色", "selector": "#chart-sample-5", "surfaceTheme": "ink", "colorEquals": { "backgroundColor": "#93AECB" } },
  { "name": "paper 实际危险按钮 AA 对比度", "selector": "#fx-danger", "surfaceTheme": "paper", "contrast": { "min": 4.5 } },
  { "name": "ink 实际危险按钮 AA 对比度", "selector": "#fx-danger", "surfaceTheme": "ink", "contrast": { "min": 4.5 } }
]
