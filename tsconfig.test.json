{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"useDefineForClassFields": false
	},
	"include": [
		"src/**/*.test.ts",
